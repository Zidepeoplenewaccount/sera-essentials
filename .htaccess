RewriteEngine On

# Give the homepage a clean /home URL while keeping the root domain working.
RewriteRule ^index/?$ /home [R=301,L]
RewriteRule ^home/?$ index.html [L]

# Redirect direct .html URLs to clean extensionless URLs.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[\s?]) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

# Internally serve matching .html files for extensionless requests.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Prevent browsers and shared caches from serving an outdated storefront.
<IfModule mod_headers.c>
  <FilesMatch "\.(html?|json)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>

